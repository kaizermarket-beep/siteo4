# Postgres (Neon) connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# Google OAuth (Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Root domain used for subdomain routing (src/proxy.ts). Locally, use
# "localhost:3000" — *.localhost resolves to loopback with no /etc/hosts
# changes needed, so slug.localhost:3000 works out of the box. In
# production this becomes the real domain (e.g. "siteo.com") once bought,
# with its nameservers pointed at Vercel for automatic wildcard TLS.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
