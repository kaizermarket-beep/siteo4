# Postgres (Neon) connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# Google OAuth (Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Root domain used for subdomain routing (src/proxy.ts). Locally, use
# "localhost:3000" — *.localhost resolves to loopback with no /etc/hosts
# changes needed, so slug.localhost:3000 works out of the box. In
# production this becomes the real domain (e.g. "siteo.com") once bought,
# with its nameservers pointed at Vercel for automatic wildcard TLS.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Stripe (billing). Test-mode values live in .env.local, which is gitignored.
# The publishable key is client-side by design and safe to expose; the other
# two are secrets and must never be committed or pasted into a chat.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Prefer a restricted key (rk_…) over a secret key (sk_…) — least privilege.
STRIPE_SECRET_KEY=""
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints this.
STRIPE_WEBHOOK_SECRET=""

# Transactional email (Resend). Optional: without it the site still works and
# every request lands in the dashboard, only the confirmation emails are
# skipped — see src/lib/email.ts. MAIL_FROM must be an address on a domain
# verified in Resend, e.g. "Salon <rendezvous@votredomaine.fr>".
RESEND_API_KEY=""
MAIL_FROM=""
